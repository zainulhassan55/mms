# Copy to .env and fill in values:
#   copy .env.example .env

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mms?schema=public"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
# Keep false for real multi-user auth (no role switching)
DEMO_MODE="false"
# Bootstrap Editor in Chief (required for npm run db:seed)
ADMIN_EMAIL="you@your-real-email.com"
ADMIN_SEED_PASSWORD="choose-a-strong-password"
# Optional local demo users (@test.example) — leave false for production
SEED_DEMO_STAFF="false"

# Email notifications (OJS-style workflow mail)
# false = log emails to server console (safe for local demo)
# true  = send through SMTP (Gmail app password, SendGrid, Mailgun, Hostinger, etc.)
EMAIL_DELIVERY="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="noreply@yourdomain.org"
# Publisher / platform brand (NOT one journal). Used as email From-name
# and fallback header. Each message still names the specific journal
# (IJDH, etc.) from the manuscript record.
MAIL_FROM_NAME="CCRI Research Editorial Office"
JOURNAL_NAME="CCRI Research"
# Public frontend URL used in email buttons/links
FRONTEND_URL="http://localhost:5173"
FRONTEND_BASE="/mms"
# Test: npx tsx scripts/test-mail.ts you@example.com
#
# Events that email the right person:
# - Account welcome (self-register / admin-created)
# - Password reset
# - Submission received (author + journal editors/EIC)
# - Screening pass / formatting / desk reject (author)
# - Reviewer invite / accept-decline / review submitted
# - Editor recommendation → EIC
# - EIC final decision → author
# - Author revision received (author + EIC or editor)
# - EIC routes revision → handling editor (+ author)
# - Copyeditor assigned / production handoff / proof / published
# - Deadline reminders (reviewer + author revision)
# User Settings toggles: notifyEmail, notifyDeadlines, notifyDecisions

# Deadline reminders (reviewers + author revisions)
# Prefer cron: 0 9 * * * cd /path/to/server && npm run reminders
REMINDERS_ENABLED="false"
REMINDERS_INTERVAL_HOURS="24"
REMINDER_DAYS_BEFORE="3"
REMINDER_MIN_HOURS="24"
REMINDER_MAX_PER_ITEM="5"
