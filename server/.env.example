# Copy to .env and fill in values:
#   copy .env.example .env

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mms?schema=public"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
# Keep false for real multi-user auth (no role switching)
DEMO_MODE="false"
# Optional: password for seeded bootstrap admin (admin@publisher.example)
ADMIN_SEED_PASSWORD="admin123"

# Email notifications (OJS-style workflow mail)
# false = log emails to server console (safe for local demo)
# true  = send through SMTP
EMAIL_DELIVERY="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="noreply@yourjournal.org"
MAIL_FROM_NAME="Journal Editorial Office"
JOURNAL_NAME="Journal of Data Science and Intelligent Systems"
# Public frontend URL used in email buttons/links
FRONTEND_URL="http://localhost:5173"
FRONTEND_BASE="/mms"

# Deadline reminders (reviewers + author revisions)
# Prefer cron: 0 9 * * * cd /path/to/server && npm run reminders
REMINDERS_ENABLED="false"
REMINDERS_INTERVAL_HOURS="24"
REMINDER_DAYS_BEFORE="3"
REMINDER_MIN_HOURS="24"
REMINDER_MAX_PER_ITEM="5"
